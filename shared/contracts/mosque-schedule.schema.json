{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Salahaldin mosque unified calendar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mosqueId",
    "timezone",
    "city",
    "timetable"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mosqueId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone, e.g. Europe/Copenhagen; DST handled by timezone rules"
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "timetable": {
      "type": "object",
      "patternProperties": {
        "^\\d{4}-\\d{2}-\\d{2}$": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      },
      "additionalProperties": false
    },
    "iqama": {
      "type": "object",
      "properties": {
        "fajr": {
          "type": "object",
          "required": [
            "mode",
            "offset",
            "time"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "offset"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        },
        "dhuhr": {
          "type": "object",
          "required": [
            "mode",
            "offset",
            "time"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "offset"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        },
        "asr": {
          "type": "object",
          "required": [
            "mode",
            "offset",
            "time"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "offset"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        },
        "maghrib": {
          "type": "object",
          "required": [
            "mode",
            "offset",
            "time"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "offset"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        },
        "isha": {
          "type": "object",
          "required": [
            "mode",
            "offset",
            "time"
          ],
          "properties": {
            "mode": {
              "enum": [
                "fixed",
                "offset"
              ]
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        }
      }
    },
    "dailyIqama": {
      "type": "object",
      "description": "Optional fixed, mosque-authorized iqama HH:MM by local civil date",
      "patternProperties": {
        "^\\d{4}-\\d{2}-\\d{2}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fajr": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "dhuhr": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "asr": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "maghrib": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "isha": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
